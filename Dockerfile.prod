FROM python:3.11-slim as builder

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
        libgdal-dev \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src/app

COPY Pipfile Pipfile.lock ./
RUN pip install --no-cache-dir pipenv && \
    pipenv install --system --deploy --ignore-pipfile


FROM python:3.11-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libpq5 \
        libgdal-dev \
        curl \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r django_group && \
    useradd -r -g django_group -s /bin/false django_user


WORKDIR /usr/src/app

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin
COPY --chown=django_user:django_group . .

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DJANGO_SETTINGS_MODULE=config.settings

RUN mkdir -p /usr/src/app/staticfiles /usr/src/app/media && \
    chown -R django_user:django_group /usr/src/app

USER django_user
RUN python manage.py collectstatic --noinput || true

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health/ || exit 1

EXPOSE 8000

CMD ["gunicorn", "config.wsgi:application", "-c", "gunicorn.conf.py"]